require('dotenv').config();
const express = require('express');
const axios = require('axios');

const app = express();
app.use(express.json({ limit: '10mb' }));

const PORT = process.env.PORT || 3000;

const PRINTNODE_API_KEY = process.env.PRINTNODE_API_KEY;
const PRINTNODE_PRINTER_ID = Number(process.env.PRINTNODE_PRINTER_ID);

const CIN7_ACCOUNT_ID = process.env.CIN7_ACCOUNT_ID;
const CIN7_APPLICATION_KEY = process.env.CIN7_APPLICATION_KEY;
const CIN7_BASE_URL = process.env.CIN7_BASE_URL || 'https://inventory.dearsystems.com/ExternalApi';

app.get('/', (req, res) => {
  res.send('Cin7 auto print server is running');
});

app.post('/webhook/cin7', async (req, res) => {
  try {
    console.log('Webhook received:', JSON.stringify(req.body, null, 2));

    const saleOrderNumber =
      req.body.SaleOrderNumber ||
      req.body.saleOrderNumber ||
      req.body.OrderNumber ||
      req.body.orderNumber;

    if (!saleOrderNumber) {
      return res.status(400).json({
        ok: false,
        message: 'SaleOrderNumber not found in webhook payload'
      });
    }

    const saleResponse = await axios.get(`${CIN7_BASE_URL}/Sale`, {
      headers: {
        'api-auth-accountid': CIN7_ACCOUNT_ID,
        'api-auth-applicationkey': CIN7_APPLICATION_KEY
      },
      params: {
        SaleOrderNumber: saleOrderNumber
      }
    });

    const saleData = saleResponse.data;

    const possiblePdfUrl =
      saleData.InvoiceUrl ||
      saleData.InvoicePDFUrl ||
      saleData.PdfUrl ||
      saleData.PDFUrl;

    if (!possiblePdfUrl) {
      return res.status(500).json({
        ok: false,
        message: 'Invoice PDF URL not found in Cin7 response',
        saleOrderNumber,
        cin7Response: saleData
      });
    }

    const pdfResponse = await axios.get(possiblePdfUrl, {
      responseType: 'arraybuffer'
    });

    const pdfBase64 = Buffer.from(pdfResponse.data).toString('base64');

    const printPayload = {
      printerId: PRINTNODE_PRINTER_ID,
      title: `Cin7 Invoice ${saleOrderNumber}`,
      contentType: 'pdf_base64',
      content: pdfBase64,
      source: 'Cin7 Auto Print'
    };

    const printResponse = await axios.post(
      'https://api.printnode.com/printjobs',
      printPayload,
      {
        auth: {
          username: PRINTNODE_API_KEY,
          password: ''
        },
        headers: {
          'Content-Type': 'application/json'
        }
      }
    );

    console.log('PrintNode response:', printResponse.data);

    return res.json({
      ok: true,
      saleOrderNumber,
      printJobId: printResponse.data
    });

  } catch (error) {
    console.error('ERROR:', error.response?.data || error.message);
    return res.status(500).json({
      ok: false,
      error: error.response?.data || error.message
    });
  }
});

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
